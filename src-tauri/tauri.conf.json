{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swallow",
  "version": "0.1.0",
  "identifier": "xyz.cloudyi.swallow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "Swallow - Loading",
        "url": "splash.html",
        "width": 600,
        "height": 400,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "swallow",
        "width": 1366,
        "height": 768,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-9ZkjG4FTe819+7fRx03nDEHHMxTM3g53Yur2S0Wl0h8='; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'sha256-9ZkjG4FTe819+7fRx03nDEHHMxTM3g53Yur2S0Wl0h8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
